+<body><div class="wrap"><header class="page"><div class="eyebrow">Implementation plan · phases and tasks</div>
+<a class="back" href="{{primary_source_href}}">Related source</a><h1>{{title}}</h1><p class="lede">{{one_sentence_outcome}}</p>
+<div class="promptcard"><div class="label">Requested scope</div><button class="copybtn" id="copyScope" type="button">copy scope</button><blockquote id="scopeText">{{requested_scope}}</blockquote></div></header>
+<div class="divider">The plan</div><div class="doc"><div class="doc-head"><span class="dot"></span><span class="path">{{evidence_date_and_source}}</span><span class="meta">Proposal · implementation pending</span></div>
+<div class="doc-summary"><div class="stat"><div class="n">1</div><div class="t">Phases</div></div><div class="stat"><div class="n">0/1</div><div class="t">Proposed tasks done</div></div></div>
+<div class="chips" aria-label="Filter entries"><button class="chip on" data-f="all" type="button" aria-pressed="true">All <span class="ct">1</span></button><button class="chip" data-f="plan" type="button" aria-pressed="false">Phases <span class="ct">1</span></button></div>
+<div class="timeline" id="timeline"><div class="entry t-plan" data-t="plan" id="p1" data-state="todo"><div class="ts">P1</div><div class="rail"><span class="node"></span></div><div class="body">
+<details class="fold" open><summary><span class="badge">Phase 1 · {{component}} · proposed</span><span class="ts-mobile">P1</span>
+<h3>{{phase_outcome}}</h3><span class="waits">{{phase_dependencies}}</span><span class="mini"><span class="minitask">0/1 tasks complete</span></span><span class="chev" aria-hidden="true"></span></summary>
+<div class="foldbody"><p>{{phase_purpose}}</p><div class="devgrid">
+<div class="row"><div class="k">Tasks · 0 of 1</div><div class="v"><ul class="tasklist"><li class="m-todo"><span class="bx" aria-label="Not complete">·</span><span class="id">1.1</span><a class="tx" href="#task-1.1">{{observable_change_and_why_it_matters}}</a></li></ul></div></div>
+<div class="row"><div class="k">Acceptance</div><div class="v"><ul class="acclist"><li class="todo"><span class="bx" aria-label="Not verified">·</span>{{observable_phase_acceptance_condition}}</li></ul></div></div>
+<div class="row"><div class="k">Done when</div><div class="v">{{phase_completion_condition}}</div></div></div>
+<div class="divider">Detailed tasks</div><details class="pcard" id="task-1.1" data-task="1.1" data-status="proposed">
+<summary><span class="ptag t">1.1</span><span class="pname">{{observable_change_and_why_it_matters}}</span><span class="pstate">Proposed</span><span class="chev" aria-hidden="true"></span></summary>
+<div class="pwrap"><div class="devgrid"><div class="row"><div class="k">Files</div><div class="v">{{exact_source_files_and_functions_or_ui_elements}}</div></div>
+<div class="row"><div class="k">Implement</div><div class="v">{{specific_implementation_steps}}</div></div>
+<div class="row"><div class="k">Preserve</div><div class="v">{{required_behavior_and_constraints}}</div></div>
+<div class="row"><div class="k">Visible result</div><div class="v">{{what_the_owner_or_customer_will_see}}</div></div>
+<div class="row"><div class="k">Done when</div><div class="v">{{observable_completion_condition_and_evidence_or_pending_status}}</div></div></div></div></details></div></details></div></div></div></div>
+<div class="next" id="decisions"><div class="label">Owner decisions</div><h2>{{unresolved_decision_or_No_unresolved_choice}}</h2><p class="sub">{{decision_options_or_Nothing_open_The_current_evidence_supports_the_recorded_outcome}}</p></div>
+<footer><a href="{{primary_source_href}}">{{primary_source_label}}</a><br>Source code and linked evidence remain authoritative. A proposed task is not evidence of implementation or acceptance.</footer></div>
+<nav class="jump" aria-label="Jump to a phase"><div class="bar"><button id="jTop" type="button" aria-label="Back to top">↑</button><span class="sep"></span><a href="#p1" data-state="todo" aria-label="Phase 1">1</a><span class="sep"></span><button id="jAll" type="button" aria-label="Expand or collapse all phases" aria-pressed="false">↕</button></div></nav>
