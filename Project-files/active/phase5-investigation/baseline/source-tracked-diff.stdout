+(function () {
+  function reveal(hash) {
+    if (!hash || hash === '#') return;
+    var target = document.getElementById(hash.slice(1));
+    if (!target) return;
+    var all = document.querySelector('.chip[data-f="all"]');
+    if (all && !all.classList.contains('on')) all.click();
+    for (var el = target; el; el = el.parentElement) {
+      if (el.tagName === 'DETAILS') el.open = true;
+    }
+    var fold = target.querySelector('details.fold');
+    if (fold) fold.open = true;
+  }
+  document.addEventListener('click', function (e) {
+    var a = e.target.closest('a[href^="#"]');
+    if (a) reveal(a.getAttribute('href'));
+  });
+  window.addEventListener('hashchange', function () { reveal(location.hash); });
+  reveal(location.hash);
+  var top = document.getElementById('jTop'), toggle = document.getElementById('jAll');
+  if (top) top.addEventListener('click', function () { window.scrollTo({ top: 0 }); });
+  if (toggle) {
+    function sync() {
+      var folds = Array.from(document.querySelectorAll('details.fold'));
+      toggle.setAttribute('aria-pressed', String(folds.every(function (d) { return d.open; })));
+    }
+    toggle.addEventListener('click', function () {
+      var folds = Array.from(document.querySelectorAll('details.fold'));
+      var open = !folds.every(function (d) { return d.open; });
+      folds.forEach(function (d) { d.open = open; });
+      sync();
+    });
+    document.querySelectorAll('details.fold').forEach(function (d) { d.addEventListener('toggle', sync); });
+    sync();
+  }
+})();
+</script></body></html>
