+                   firstError == nil || error.0 < firstError!.0 { firstError = error }
+            }
+            if let firstError { throw firstError.1 }
+            try requireRoot()
+        }
+        try scan()
+        try requireBinding()
+        try scan()
+        try requireBinding()
+        return resources.snapshot()
+    }
