+                    "grouped": try metrics(grouped, label: "grouped numerical"), "allRowsRoutesStateExact": true]
+        }
+        func boundaries(inputs: [Int32], history: [Int32], sampleBase: Int) async throws -> [[String: Any]] {
+            var checks: [[String: Any]] = []
